class GateError(RuntimeError):
    """Disposable-guest E2E setup cannot proceed safely."""


class _GuestOps(Protocol):
    def verify_root_and_workspace(self) -> None: ...

    def require_clean_start(self) -> None: ...

    def prepare(self) -> None: ...

    def run_probe(self) -> int: ...

    def cleanup(self) -> None: ...

    def verify_clean(self) -> None: ...


def _run(
    command: Sequence[str],
    *,
    timeout: int,
    env: Mapping[str, str] | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        list(command),
        capture_output=True,
        text=True,
        check=check,
        timeout=timeout,
        env=dict(env) if env is not None else None,
    )


def _read_expected_commit(path: Path) -> str:
    try:
        text = path.read_text(encoding="ascii")
    except OSError as exc:
        raise GateError("expected-commit config is unavailable") from exc

    match = _COMMIT_LINE.fullmatch(text)
    if match is None:
        raise GateError("expected-commit config must contain one exact 40-hex line")
    return match.group(1).lower()


def _require_clean_start(runtime: Path, cgroup_root: Path) -> None:
    if runtime.exists() or cgroup_root.exists():
        raise GateError("stale disposable E2E fixture state detected")


def _require_trusted_harness() -> None:
    try:
        root_info = TRUSTED_HARNESS_ROOT.lstat()
        root_resolved = TRUSTED_HARNESS_ROOT.resolve(strict=True)
        fs = os.statvfs(TRUSTED_HARNESS_ROOT)
    except (OSError, RuntimeError) as exc:
        raise GateError("trusted harness is unavailable") from exc
    if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode):
        raise GateError("trusted harness root is not a canonical directory")
    if root_resolved != TRUSTED_HARNESS_ROOT:
        raise GateError("trusted harness root is not canonical")
    if not (fs.f_flag & os.ST_RDONLY):
        raise GateError("trusted harness filesystem is not read-only")

    try:
        info = _TRUSTED_GATE.lstat()
        resolved = _TRUSTED_GATE.resolve(strict=True)
    except (OSError, RuntimeError) as exc:
        raise GateError("trusted guest gate source is unavailable") from exc
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise GateError("trusted guest gate source is not a regular file")
    if resolved != _TRUSTED_GATE:
        raise GateError("trusted guest gate source is not canonical")
    try:
        resolved.relative_to(TRUSTED_HARNESS_ROOT)
    except ValueError as exc:
        raise GateError("trusted guest gate source escapes payload") from exc

    if Path(__file__).resolve(strict=True) != _TRUSTED_GATE:
        raise GateError("guest gate is not executing from trusted payload")


def _require_target_regular(path: Path) -> None:
    try:
        info = path.lstat()
        resolved = path.resolve(strict=True)
    except (OSError, RuntimeError) as exc:
        raise GateError(f"required target source is unavailable: {path}") from exc
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise GateError(f"required target source is not a regular file: {path}")
    if resolved != path:
        raise GateError(f"required target source is not canonical: {path}")
    try:
        resolved.relative_to(WORKSPACE)
    except ValueError as exc:
        raise GateError(f"required target source escapes workspace: {path}") from exc


def _verify_root_owned_regular(path: Path, *, mode: int) -> None:
    try:
        info = path.lstat()
    except OSError as exc:
        raise GateError(f"required file is unavailable: {path}") from exc
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise GateError(f"required file is not a regular file: {path}")
    if info.st_uid != 0:
        raise GateError(f"required file is not root-owned: {path}")
    if stat.S_IMODE(info.st_mode) != mode:
        raise GateError(f"unexpected file mode for {path}")


def _write_control(path: Path, value: str) -> None:
    flags = os.O_WRONLY | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(path, flags)
        try:
            data = value.encode("ascii")
            offset = 0
            while offset < len(data):
                written = os.write(fd, data[offset:])
                if written <= 0:
                    raise GateError(f"short write to {path}")
                offset += written
        finally:
            os.close(fd)
    except OSError as exc:
        raise GateError(f"cannot write cgroup control: {path}") from exc


def _status_fields(pid: int | None = None) -> dict[str, str]:
    path = Path("/proc/self/status" if pid is None else f"/proc/{pid}/status")
    try:
        raw = path.read_text(encoding="ascii")
    except OSError as exc:
        raise GateError("cannot read process status") from exc
    result: dict[str, str] = {}
    for line in raw.splitlines():
        key, separator, value = line.partition(":")
        if separator:
            result[key] = value.strip()
    return result


def _require_zero_caps_nnp() -> None:
    fields = _status_fields()
    for key in ("CapInh", "CapPrm", "CapEff", "CapAmb"):
        if int(fields.get(key, "-1"), 16) != 0:
            raise GateError("non-root child retained Linux capabilities")
    if fields.get("NoNewPrivs") != "1":
        raise GateError("non-root child lacks no_new_privs")


def _spawn_nonroot_child(
    command: Sequence[str],
    *,
    uid: int,
    gid: int,
    groups: tuple[int, ...],
    env: Mapping[str, str],
) -> int:
    if not command or not Path(command[0]).is_absolute():
        raise GateError("non-root child command must be fixed and absolute")

    pid = os.fork()
    if pid == 0:
        try:
            os.setgroups(list(groups))
            os.setresgid(gid, gid, gid)
            os.setresuid(uid, uid, uid)
            libc = ctypes.CDLL(None, use_errno=True)
            if libc.prctl(_PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
                os._exit(125)
            _require_zero_caps_nnp()
            os.execve(command[0], list(command), dict(env))
        except BaseException:  # noqa: BLE001 - fork child must never unwind into root gate
            os._exit(126)
    return pid


def _wait_pid(pid: int, *, timeout_seconds: float) -> int:
    deadline = time.monotonic() + timeout_seconds
    while True:
        waited, status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            if os.WIFEXITED(status):
                return os.WEXITSTATUS(status)
            if os.WIFSIGNALED(status):
                return 128 + os.WTERMSIG(status)
            return 125
        if time.monotonic() >= deadline:
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            time.sleep(0.2)
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            os.waitpid(pid, 0)
            raise GateError("fixture child timed out")
        time.sleep(0.05)


def _stop_pid(pid: int | None) -> None:
    if pid is None:
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline:
        waited, _status = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            return
        time.sleep(0.05)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        os.waitpid(pid, 0)
    except ChildProcessError:
        pass


def _account_absent(*, name: str, numeric_id: int, user: bool) -> None:
    try:
        if user:
            pwd.getpwnam(name)
        else:
            grp.getgrnam(name)
    except KeyError:
        pass
    else:
        raise GateError(f"fixture identity already exists: {name}")

    try:
        if user:
            pwd.getpwuid(numeric_id)
        else:
            grp.getgrgid(numeric_id)
    except KeyError:
        return
    raise GateError(f"fixture numeric identity already exists: {numeric_id}")


