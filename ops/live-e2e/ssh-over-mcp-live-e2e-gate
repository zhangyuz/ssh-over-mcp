        SSHD_CONFIG.write_text(config, encoding="ascii")
        os.chown(SSHD_CONFIG, 0, 0)
        os.chmod(SSHD_CONFIG, 0o600)
        SSHD_LOG.touch(mode=0o640)
        os.chown(SSHD_LOG, 0, PROBE_GID)
        os.chmod(SSHD_LOG, 0o640)
        _run([_SSHD, "-t", "-f", str(SSHD_CONFIG)], timeout=15)

    def _start_manager(self) -> None:
        env = _fixed_child_env()
        env.update(
            {
                "SSH_OVER_MCP_LIVE_E2E_MANAGER_ENDPOINT": str(MANAGER_ENDPOINT),
                "SSH_OVER_MCP_LIVE_E2E_CGROUP_ROOT": str(CGROUP_ROOT),
                "SSH_OVER_MCP_LIVE_E2E_MANAGER_UID": str(MANAGER_UID),
                "SSH_OVER_MCP_LIVE_E2E_MANAGER_GID": str(MANAGER_GID),
                "SSH_OVER_MCP_LIVE_E2E_HOST_UID": str(HOST_UID),
                "SSH_OVER_MCP_LIVE_E2E_HOST_GID": str(HOST_GID),
                "SSH_OVER_MCP_LIVE_E2E_WORKLOAD_UID": str(WORKLOAD_UID),
                "SSH_OVER_MCP_LIVE_E2E_WORKLOAD_GID": str(WORKLOAD_GID),
                "SSH_OVER_MCP_LIVE_E2E_MANAGER_CLIENT_GID": str(MANAGER_CLIENT_GID),
            }
        )
        self._manager_pid = _spawn_nonroot_child(
            [str(VENV_PYTHON), str(_MANAGER_SCRIPT)],
            uid=MANAGER_UID,
            gid=MANAGER_GID,
            groups=(MANAGER_CLIENT_GID,),
            env=env,
        )
        deadline = time.monotonic() + 10.0
        while time.monotonic() < deadline:
            if MANAGER_ENDPOINT.exists():
                return
            waited, status = os.waitpid(self._manager_pid, os.WNOHANG)
            if waited == self._manager_pid:
                self._manager_pid = None
                raise GateError(f"containment manager exited during startup: {status}")
            time.sleep(0.05)
        raise GateError("containment manager endpoint did not become ready")

    def _start_sshd(self) -> None:
        pid = os.fork()
        if pid == 0:
            try:
                os.execve(
                    _SSHD,
                    [_SSHD, "-D", "-f", str(SSHD_CONFIG), "-E", str(SSHD_LOG)],
                    {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
                )
            except BaseException:  # noqa: BLE001 - fork child must never unwind into root gate
                os._exit(126)
        self._sshd_pid = pid

        deadline = time.monotonic() + 10.0
        while time.monotonic() < deadline:
            waited, status = os.waitpid(pid, os.WNOHANG)
            if waited == pid:
                self._sshd_pid = None
                raise GateError(f"sshd exited during startup: {status}")
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as check:
                check.settimeout(0.2)
                if check.connect_ex(("127.0.0.1", SSHD_PORT)) == 0:
                    return
            time.sleep(0.05)
        raise GateError("sshd did not become ready")

    def prepare(self) -> None:
        RUNTIME.mkdir(mode=0o755, parents=False, exist_ok=False)
        os.chown(RUNTIME, 0, 0)
        os.chmod(RUNTIME, 0o755)
        self._prepare_identities()
        self._prepare_cgroup()
        self._prepare_launcher_and_sudo()
        self._prepare_manager_endpoint_parent()
        self._prepare_keys()
        self._prepare_state_and_policy()
        self._prepare_sshd_config()
        self._start_manager()
        self._start_sshd()

    def _probe_env(self) -> dict[str, str]:
        if self._expected_commit is None:
            raise GateError("guest expected commit was not verified")
        env = _fixed_child_env()
        env.update(
            {
                "SSH_OVER_MCP_LIVE_EXPECTED_COMMIT": self._expected_commit,
                "SSH_OVER_MCP_RUN_LIVE_LOCAL_E2E": "1",
                "SSH_OVER_MCP_LIVE_E2E_HOST": "127.0.0.1",
                "SSH_OVER_MCP_LIVE_E2E_PORT": str(SSHD_PORT),
                "SSH_OVER_MCP_LIVE_E2E_SSH_USER": HOST_USER,
                "SSH_OVER_MCP_LIVE_E2E_PRIVATE_KEY": str(CLIENT_KEY),
                "SSH_OVER_MCP_LIVE_E2E_HOST_KEY_PUBLIC": str(HOST_KEY_PUBLIC),
                "SSH_OVER_MCP_LIVE_E2E_MANAGER_ENDPOINT": str(MANAGER_ENDPOINT),
                "SSH_OVER_MCP_LIVE_E2E_CGROUP_ROOT": str(CGROUP_ROOT),
                "SSH_OVER_MCP_LIVE_E2E_HOST_SOURCE_CGROUP": str(HOST_SOURCE_CGROUP),
                "SSH_OVER_MCP_LIVE_E2E_STATE_SCRIPT": str(STATE_SCRIPT),
                "SSH_OVER_MCP_LIVE_E2E_WORK_DIR": str(WORK_DIR),
                "SSH_OVER_MCP_LIVE_E2E_MANAGER_UID": str(MANAGER_UID),
                "SSH_OVER_MCP_LIVE_E2E_MANAGER_GID": str(MANAGER_GID),
                "SSH_OVER_MCP_LIVE_E2E_HOST_UID": str(HOST_UID),
                "SSH_OVER_MCP_LIVE_E2E_HOST_GID": str(HOST_GID),
                "SSH_OVER_MCP_LIVE_E2E_WORKLOAD_UID": str(WORKLOAD_UID),
                "SSH_OVER_MCP_LIVE_E2E_WORKLOAD_GID": str(WORKLOAD_GID),
                "SSH_OVER_MCP_LIVE_E2E_PROBE_UID": str(PROBE_UID),
                "SSH_OVER_MCP_LIVE_E2E_PROBE_GID": str(PROBE_GID),
                "SSH_OVER_MCP_LIVE_E2E_MANAGER_CLIENT_GID": str(MANAGER_CLIENT_GID),
            }
        )
        return env

    def _verify_privileged_fixture(self) -> None:
        for path in (CGROUP_ROOT, HOST_SOURCE_CGROUP):
            try:
                info = path.lstat()
            except OSError as exc:
                raise GateError(f"privileged fixture directory is unavailable: {path}") from exc
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                raise GateError(f"privileged fixture path is not a directory: {path}")
            if (info.st_uid, info.st_gid) != (MANAGER_UID, MANAGER_GID):
                raise GateError(f"privileged fixture directory identity mismatch: {path}")
            if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
                raise GateError(f"privileged fixture directory is broadly writable: {path}")

        try:
            info = MANAGER_ENDPOINT.lstat()
        except OSError as exc:
            raise GateError("manager endpoint is unavailable before probe") from exc
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISSOCK(info.st_mode):
            raise GateError("manager endpoint is not a Unix socket before probe")
        if (
            info.st_uid != MANAGER_UID
            or info.st_gid != MANAGER_CLIENT_GID
            or stat.S_IMODE(info.st_mode) != 0o660
        ):
            raise GateError("manager endpoint identity/mode mismatch before probe")

    def run_probe(self) -> int:
        self._verify_privileged_fixture()
        pid = _spawn_nonroot_child(
            [str(VENV_PYTHON), str(_PROBE)],
            uid=PROBE_UID,
            gid=PROBE_GID,
            groups=(),
            env=self._probe_env(),
        )
        return _wait_pid(pid, timeout_seconds=300.0)

    def _cleanup_cgroup(self) -> None:
        if not CGROUP_ROOT.exists():
            if self._top_added_controllers:
                top = Path("/sys/fs/cgroup/cgroup.subtree_control")
                _write_control(
                    top,
                    " ".join(f"-{name}" for name in sorted(self._top_added_controllers))
                    + "\n",
                )
                self._top_added_controllers.clear()
            return

        errors: list[str] = []
        for child in list(CGROUP_ROOT.iterdir()):
            if not child.is_dir():
                continue
            if child == HOST_SOURCE_CGROUP or child.name.startswith("ssh-over-mcp-"):
                try:
                    events = (child / "cgroup.events").read_text(encoding="ascii")
                    if "populated 1" in events:
                        _write_control(child / "cgroup.kill", "1\n")
                        errors.append(f"populated cgroup leaked: {child.name}")
                    deadline = time.monotonic() + 2.0
                    while (child / "cgroup.procs").read_text(encoding="ascii").strip():
                        if time.monotonic() >= deadline:
                            raise GateError(f"cgroup did not become empty: {child}")
                        time.sleep(0.02)
                    child.rmdir()
                except (OSError, UnicodeError) as exc:
                    raise GateError(f"cannot clean cgroup child: {child}") from exc
            else:
                raise GateError(f"refusing unexpected cgroup child: {child.name}")

        root_procs = (CGROUP_ROOT / "cgroup.procs").read_text(encoding="ascii").strip()
        if root_procs:
            raise GateError("refusing populated delegated cgroup root")
        enabled = (CGROUP_ROOT / "cgroup.subtree_control").read_text(encoding="ascii").split()
        if enabled:
            _write_control(
                CGROUP_ROOT / "cgroup.subtree_control",
                " ".join(f"-{name}" for name in sorted(enabled)) + "\n",
            )
        CGROUP_ROOT.rmdir()

        if self._top_added_controllers:
            _write_control(
                Path("/sys/fs/cgroup/cgroup.subtree_control"),
                " ".join(f"-{name}" for name in sorted(self._top_added_controllers))
                + "\n",
            )
            self._top_added_controllers.clear()

        if errors:
            raise GateError("; ".join(errors))

    def _remove_artifact(self, path: Path) -> None:
        try:
            path.unlink()
        except FileNotFoundError:
            return
        except OSError as exc:
            raise GateError(f"cannot remove fixture artifact: {path}") from exc

    def _remove_identities(self) -> None:
        for name in reversed(self._created_users):
            command = [_USERDEL, "-r", name] if name == HOST_USER else [_USERDEL, name]
            result = _run(command, timeout=20, check=False)
            if result.returncode != 0:
                raise GateError(f"cannot remove fixture user: {name}")
        self._created_users.clear()

        group_ids = {
            MANAGER_GROUP: MANAGER_GID,
            HOST_GROUP: HOST_GID,
            WORKLOAD_GROUP: WORKLOAD_GID,
            PROBE_GROUP: PROBE_GID,
            MANAGER_CLIENT_GROUP: MANAGER_CLIENT_GID,
        }
        for name in reversed(self._created_groups):
            gid = group_ids[name]
            try:
                grp.getgrnam(name)
            except KeyError:
                _account_absent(name=name, numeric_id=gid, user=False)
                continue
            result = _run([_GROUPDEL, name], timeout=20, check=False)
            if result.returncode != 0:
                raise GateError(f"cannot remove fixture group: {name}")
            _account_absent(name=name, numeric_id=gid, user=False)
        self._created_groups.clear()

    def cleanup(self) -> None:
        failures: list[tuple[str, BaseException]] = []

        for stage, attr in (("sshd", "_sshd_pid"), ("manager", "_manager_pid")):
            pid = getattr(self, attr)
            try:
                _stop_pid(pid)
            except BaseException as exc:  # noqa: BLE001 - teardown must aggregate every failure
                failures.append((stage, exc))
            setattr(self, attr, None)

        try:
            self._cleanup_cgroup()
        except BaseException as exc:  # noqa: BLE001 - teardown must aggregate every failure
            failures.append(("cgroup", exc))

        for stage, path in (
            ("sudoers", SUDOERS_DROPIN),
            ("launcher", LAUNCHER_INSTALL),
        ):
            try:
                self._remove_artifact(path)
            except BaseException as exc:  # noqa: BLE001 - teardown must aggregate every failure
                failures.append((stage, exc))

        try:
            if HOST_POLICY.exists():
                info = HOST_POLICY.stat()
                if self._host_policy_identity != (info.st_dev, info.st_ino):
                    raise GateError("host policy path changed before cleanup")
                HOST_POLICY.unlink()
        except BaseException as exc:  # noqa: BLE001 - teardown must aggregate every failure
            failures.append(("host_policy", exc))

        try:
            self._remove_identities()
        except BaseException as exc:  # noqa: BLE001 - teardown must aggregate every failure
            failures.append(("identities", exc))

        try:
            if RUNTIME.exists():
                shutil.rmtree(RUNTIME)
        except BaseException as exc:  # noqa: BLE001 - teardown must aggregate every failure
            failures.append(("runtime", exc))

        if failures:
            raise GateError(
                "guest fixture cleanup failed: "
                + "; ".join(
                    f"{stage}:{type(exc).__name__}" for stage, exc in failures
                )
            )

    def verify_clean(self) -> None:
        stale = [
            path
            for path in (
                RUNTIME,
                CGROUP_ROOT,
                HOST_POLICY,
                LAUNCHER_INSTALL,
                SUDOERS_DROPIN,
            )
            if path.exists() or path.is_symlink()
        ]
        if stale:
            raise GateError("disposable E2E fixture cleanup verification failed")
        for name, value, user in (
            (MANAGER_USER, MANAGER_UID, True),
            (HOST_USER, HOST_UID, True),
            (WORKLOAD_USER, WORKLOAD_UID, True),
            (PROBE_USER, PROBE_UID, True),
            (MANAGER_GROUP, MANAGER_GID, False),
            (HOST_GROUP, HOST_GID, False),
            (WORKLOAD_GROUP, WORKLOAD_GID, False),
            (PROBE_GROUP, PROBE_GID, False),
            (MANAGER_CLIENT_GROUP, MANAGER_CLIENT_GID, False),
        ):
            _account_absent(name=name, numeric_id=value, user=user)


def _run_gate(ops: _GuestOps) -> int:
    ops.verify_root_and_workspace()
    ops.require_clean_start()
    failure: BaseException | None = None
    result = 70
    try:
        ops.prepare()
        result = ops.run_probe()
    except BaseException as exc:  # noqa: BLE001 - cleanup must run on every exit path
        failure = exc
    try:
        ops.cleanup()
    except BaseException as exc:  # noqa: BLE001 - cleanup failure must be preserved
        if failure is None:
            failure = exc
    try:
        ops.verify_clean()
    except BaseException as exc:  # noqa: BLE001 - cleanup failure must be preserved
        if failure is None:
            failure = exc
    if failure is not None:
        raise failure
    return result


def main(argv: Sequence[str] | None = None) -> int:
    arguments = tuple(sys.argv[1:] if argv is None else argv)
    if arguments:
        raise GateError("guest gate accepts no arguments")
    return _run_gate(_SystemGuestOps())


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (GateError, subprocess.SubprocessError, OSError, ValueError) as exc:
        print(f"live local E2E guest gate failed: {exc}", file=sys.stderr)
        raise SystemExit(70) from None
