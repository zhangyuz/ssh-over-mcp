class _SystemGuestOps:
    def __init__(self) -> None:
        self._expected_commit: str | None = None
        self._manager_pid: int | None = None
        self._sshd_pid: int | None = None
        self._created_users: list[str] = []
        self._created_groups: list[str] = []
        self._top_added_controllers: set[str] = set()
        self._host_policy_identity: tuple[int, int] | None = None

    def verify_root_and_workspace(self) -> None:
        if os.geteuid() != 0:
            raise GateError("guest gate must execute as root")
        _verify_root_owned_regular(CONFIG, mode=0o600)
        self._expected_commit = _read_expected_commit(CONFIG)

        try:
            resolved = WORKSPACE.resolve(strict=True)
        except OSError as exc:
            raise GateError("guest workspace is unavailable") from exc
        if resolved != WORKSPACE or not WORKSPACE.is_dir():
            raise GateError("guest workspace must be the fixed canonical directory")

        observed = _run(
            ["git", "-C", str(WORKSPACE), "rev-parse", "HEAD"],
            timeout=30,
        ).stdout.strip().lower()
        if observed != self._expected_commit:
            raise GateError("guest workspace HEAD does not match expected commit")

        dirty = _run(
            ["git", "-C", str(WORKSPACE), "status", "--porcelain=v1"],
            timeout=30,
        ).stdout
        if dirty:
            raise GateError("guest workspace must be clean")

        if not VENV_PYTHON.is_file():
            raise GateError("trusted guest Python environment is unavailable")
        _require_trusted_harness()
        _require_target_regular(LAUNCHER_SOURCE)
        _require_target_regular(_MANAGER_SCRIPT)
        _require_target_regular(_PROBE)
        _require_target_regular(_SUPPORT)

    def require_clean_start(self) -> None:
        _require_clean_start(RUNTIME, CGROUP_ROOT)
        for path in (HOST_POLICY, LAUNCHER_INSTALL, SUDOERS_DROPIN):
            if path.exists() or path.is_symlink():
                raise GateError(f"stale privileged fixture path detected: {path}")
        for name, value, user in (
            (MANAGER_USER, MANAGER_UID, True),
            (HOST_USER, HOST_UID, True),
            (WORKLOAD_USER, WORKLOAD_UID, True),
            (PROBE_USER, PROBE_UID, True),
            (MANAGER_GROUP, MANAGER_GID, False),
            (HOST_GROUP, HOST_GID, False),
            (WORKLOAD_GROUP, WORKLOAD_GID, False),
            (PROBE_GROUP, PROBE_GID, False),
            (MANAGER_CLIENT_GROUP, MANAGER_CLIENT_GID, False),
        ):
            _account_absent(name=name, numeric_id=value, user=user)

        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
            probe.settimeout(0.2)
            if probe.connect_ex(("127.0.0.1", SSHD_PORT)) == 0:
                raise GateError("fixed sshd port is already in use")

    def _prepare_identities(self) -> None:
        for name, gid in (
            (MANAGER_GROUP, MANAGER_GID),
            (HOST_GROUP, HOST_GID),
            (WORKLOAD_GROUP, WORKLOAD_GID),
            (PROBE_GROUP, PROBE_GID),
            (MANAGER_CLIENT_GROUP, MANAGER_CLIENT_GID),
        ):
            _run([_GROUPADD, "-g", str(gid), name], timeout=15)
            self._created_groups.append(name)

        users = (
            (MANAGER_USER, MANAGER_UID, MANAGER_GID, "/usr/sbin/nologin", (MANAGER_CLIENT_GROUP,)),
            (HOST_USER, HOST_UID, HOST_GID, "/bin/sh", (MANAGER_CLIENT_GROUP,)),
            (WORKLOAD_USER, WORKLOAD_UID, WORKLOAD_GID, "/usr/sbin/nologin", ()),
            (PROBE_USER, PROBE_UID, PROBE_GID, "/usr/sbin/nologin", ()),
        )
        for name, uid, gid, shell, extra_groups in users:
            command = [
                _USERADD,
                "-u",
                str(uid),
                "-g",
                str(gid),
                "-s",
                shell,
            ]
            if name == HOST_USER:
                command.extend(["-m", "-d", f"/home/{HOST_USER}"])
            else:
                command.extend(["-M", "-d", "/nonexistent"])
            if extra_groups:
                command.extend(["-G", ",".join(extra_groups)])
            command.append(name)
            _run(command, timeout=15)
            self._created_users.append(name)

        # Public-key auth is the only sshd authentication method, but OpenSSH
        # rejects a shadow-locked account before public-key authentication.
        _run([_PASSWD, "-d", HOST_USER], timeout=15)

    def _prepare_cgroup(self) -> None:
        top = Path("/sys/fs/cgroup")
        controllers = set((top / "cgroup.controllers").read_text(encoding="ascii").split())
        missing_available = _REQUIRED_CONTROLLERS - controllers
        if missing_available:
            raise GateError("required cgroup-v2 controllers are unavailable")

        enabled = set((top / "cgroup.subtree_control").read_text(encoding="ascii").split())
        missing = _REQUIRED_CONTROLLERS - enabled
        if missing:
            _write_control(
                top / "cgroup.subtree_control",
                " ".join(f"+{name}" for name in sorted(missing)) + "\n",
            )
            self._top_added_controllers = set(missing)

        CGROUP_ROOT.mkdir(mode=0o700)
        HOST_SOURCE_CGROUP.mkdir(mode=0o700)
        for path in (
            CGROUP_ROOT,
            CGROUP_ROOT / "cgroup.procs",
            CGROUP_ROOT / "cgroup.subtree_control",
            HOST_SOURCE_CGROUP,
            HOST_SOURCE_CGROUP / "cgroup.procs",
        ):
            os.chown(path, MANAGER_UID, MANAGER_GID)
            if path.stat().st_mode & (stat.S_IWGRP | stat.S_IWOTH):
                raise GateError(f"delegated cgroup surface is broadly writable: {path}")

    def _prepare_launcher_and_sudo(self) -> None:
        LAUNCHER_INSTALL.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        shutil.copyfile(LAUNCHER_SOURCE, LAUNCHER_INSTALL)
        os.chown(LAUNCHER_INSTALL, 0, 0)
        os.chmod(LAUNCHER_INSTALL, 0o555)
        _verify_root_owned_regular(LAUNCHER_INSTALL, mode=0o555)

        sudoers = (
            f'Defaults:{HOST_USER} env_keep += "SSH_ORIGINAL_COMMAND SSH_TTY"\n'
            f"{HOST_USER} ALL=(root) NOPASSWD: {_FORCECOMMAND}\n"
        )
        SUDOERS_DROPIN.write_text(sudoers, encoding="ascii")
        os.chown(SUDOERS_DROPIN, 0, 0)
        os.chmod(SUDOERS_DROPIN, 0o440)
        _run([_VISUDO, "-cf", str(SUDOERS_DROPIN)], timeout=15)

    def _prepare_keys(self) -> None:
        _run(
            [_SSH_KEYGEN, "-q", "-t", "ed25519", "-N", "", "-f", str(CLIENT_KEY)],
            timeout=20,
        )
        _run(
            [_SSH_KEYGEN, "-q", "-t", "ed25519", "-N", "", "-f", str(HOST_KEY)],
            timeout=20,
        )
        os.chown(CLIENT_KEY, PROBE_UID, PROBE_GID)
        os.chmod(CLIENT_KEY, 0o600)
        os.chown(Path(str(CLIENT_KEY) + ".pub"), 0, 0)
        os.chmod(Path(str(CLIENT_KEY) + ".pub"), 0o644)
        os.chown(HOST_KEY, 0, 0)
        os.chmod(HOST_KEY, 0o600)
        os.chown(HOST_KEY_PUBLIC, 0, 0)
        os.chmod(HOST_KEY_PUBLIC, 0o644)

        public_key = Path(str(CLIENT_KEY) + ".pub").read_text(encoding="ascii").strip()
        AUTHORIZED_KEYS.write_text(f"restrict {public_key}\n", encoding="ascii")
        os.chown(AUTHORIZED_KEYS, 0, 0)
        os.chmod(AUTHORIZED_KEYS, 0o600)

    def _prepare_state_and_policy(self) -> None:
        WORK_DIR.mkdir(mode=0o755)
        os.chown(WORK_DIR, 0, 0)

        state_source = '''#!/usr/bin/python3
import json
import os
import stat
from pathlib import Path

status = {}
for line in Path("/proc/self/status").read_text(encoding="ascii").splitlines():
    if ":" in line:
        key, value = line.split(":", 1)
        status[key] = value.strip()

cgroup = ""
for line in Path("/proc/self/cgroup").read_text(encoding="ascii").splitlines():
    if line.startswith("0::"):
        cgroup = line[3:]
        break

manager_fd = False
for raw_fd in os.listdir("/proc/self/fd"):
    try:
        fd = int(raw_fd)
    except ValueError:
        continue
    if fd <= 2:
        continue
    try:
        mode = os.fstat(fd).st_mode
    except OSError:
        continue
    if stat.S_ISSOCK(mode):
        manager_fd = True
        break

print(json.dumps({
    "uids": list(os.getresuid()),
    "gids": list(os.getresgid()),
    "groups": sorted(set(os.getgroups())),
    "cap_inheritable": int(status["CapInh"], 16),
    "cap_permitted": int(status["CapPrm"], 16),
    "cap_effective": int(status["CapEff"], 16),
    "cap_ambient": int(status["CapAmb"], 16),
    "no_new_privs": int(status["NoNewPrivs"]),
    "cgroup": cgroup,
    "manager_socket_fd_present": manager_fd,
}, sort_keys=True, separators=(",", ":")))
'''
        STATE_SCRIPT.write_text(state_source, encoding="utf-8")
        os.chown(STATE_SCRIPT, 0, 0)
        os.chmod(STATE_SCRIPT, 0o555)

        resolved_python = Path("/usr/bin/python3").resolve(strict=True)
        policy = {
            "version": 4,
            "allowed_profiles": ["developer"],
            "child_limits": {
                "cpu_seconds": 20,
                "address_space_bytes": 268435456,
                "max_processes": 16,
                "file_size_bytes": 1048576,
                "open_files": 64,
            },
            "containment": {
                "manager_endpoint": str(MANAGER_ENDPOINT),
                "manager": {"uid": MANAGER_UID, "gid": MANAGER_GID},
                "host_agent": {"uid": HOST_UID, "gid": HOST_GID},
                "workload": {"uid": WORKLOAD_UID, "gid": WORKLOAD_GID},
                "manager_client_gid": MANAGER_CLIENT_GID,
                "limits": {
                    "memory_max_bytes": 134217728,
                    "pids_max": 16,
                    "cpu_quota_us": 50000,
                    "cpu_period_us": 100000,
                },
            },
            "filesystem": {},
            "commands": {
                "/usr/bin/python3": {
                    "resolved_path": str(resolved_python),
                    "argv": [
                        {
                            "mode": "exact",
                            "args": ["-I", "-S", str(STATE_SCRIPT)],
                        }
                    ],
                    "cwd_roots": [str(WORK_DIR)],
                    "allow_no_cwd": False,
                    "require_root_owned": True,
                    "allow_group_or_world_writable": False,
                    "allow_setuid_or_setgid": False,
                    "allow_file_capabilities": False,
                }
            },
            "env_allow": [],
            "max_timeout_seconds": 20,
            "max_output_bytes": 65536,
            "max_stdin_bytes": 0,
        }
        HOST_POLICY.write_text(
            json.dumps(policy, sort_keys=True, separators=(",", ":")) + "\n",
            encoding="utf-8",
        )
        os.chown(HOST_POLICY, 0, 0)
        os.chmod(HOST_POLICY, 0o644)
        info = HOST_POLICY.stat()
        self._host_policy_identity = (info.st_dev, info.st_ino)

    def _prepare_manager_endpoint_parent(self) -> None:
        manager_dir = MANAGER_ENDPOINT.parent
        manager_dir.mkdir(mode=0o750)
        os.chown(manager_dir, MANAGER_UID, MANAGER_CLIENT_GID)
        os.chmod(manager_dir, 0o750)

