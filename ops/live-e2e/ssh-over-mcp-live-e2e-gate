#!/usr/bin/python3
from __future__ import annotations

import os
import re
import shutil
import stat
import subprocess
import sys
from collections.abc import Sequence
from pathlib import Path
from typing import Protocol

WORKSPACE = Path("/opt/ssh-over-mcp-e2e/workspace")
CONFIG = Path("/etc/ssh-over-mcp/live-e2e-gate.conf")
RUNTIME = Path("/opt/ssh-over-mcp-e2e/runtime")
CGROUP_ROOT = Path("/sys/fs/cgroup/ssh-over-mcp-e2e")

SSHD_PORT = 22222
MANAGER_UID = 2201
MANAGER_GID = 3201
HOST_UID = 2202
HOST_GID = 3202
WORKLOAD_UID = 2203
WORKLOAD_GID = 3203
PROBE_UID = 2204
PROBE_GID = 3204
MANAGER_CLIENT_GID = 3299

_PROBE = WORKSPACE / "scripts" / "run-live-local-e2e-probe.py"
_COMMIT_LINE = re.compile(r"EXPECTED_COMMIT=([0-9a-fA-F]{40})\n\Z")


class GateError(RuntimeError):
    """Disposable-guest E2E setup cannot proceed safely."""


class _GuestOps(Protocol):
    def verify_root_and_workspace(self) -> None: ...

    def require_clean_start(self) -> None: ...

    def prepare(self) -> None: ...

    def run_probe(self) -> int: ...

    def cleanup(self) -> None: ...

    def verify_clean(self) -> None: ...


def _run(
    command: Sequence[str],
    *,
    timeout: int,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        list(command),
        capture_output=True,
        text=True,
        check=True,
        timeout=timeout,
        env=env,
    )


def _read_expected_commit(path: Path) -> str:
    try:
        text = path.read_text(encoding="ascii")
    except OSError as exc:
        raise GateError("expected-commit config is unavailable") from exc

    match = _COMMIT_LINE.fullmatch(text)
    if match is None:
        raise GateError("expected-commit config must contain one exact 40-hex line")
    return match.group(1).lower()


def _require_clean_start(runtime: Path, cgroup_root: Path) -> None:
    if runtime.exists() or cgroup_root.exists():
        raise GateError("stale disposable E2E fixture state detected")


def _verify_root_owned_regular(path: Path, *, mode: int) -> None:
    try:
        info = path.lstat()
    except OSError as exc:
        raise GateError(f"required file is unavailable: {path}") from exc
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise GateError(f"required file is not a regular file: {path}")
    if info.st_uid != 0:
        raise GateError(f"required file is not root-owned: {path}")
    if stat.S_IMODE(info.st_mode) != mode:
        raise GateError(f"unexpected file mode for {path}")


class _SystemGuestOps:
    def __init__(self) -> None:
        self._expected_commit: str | None = None

    def verify_root_and_workspace(self) -> None:
        if os.geteuid() != 0:
            raise GateError("guest gate must execute as root")
        _verify_root_owned_regular(CONFIG, mode=0o600)
        self._expected_commit = _read_expected_commit(CONFIG)

        try:
            resolved = WORKSPACE.resolve(strict=True)
        except OSError as exc:
            raise GateError("guest workspace is unavailable") from exc
        if resolved != WORKSPACE or not WORKSPACE.is_dir():
            raise GateError("guest workspace must be the fixed canonical directory")

        observed = _run(
            ["git", "-C", str(WORKSPACE), "rev-parse", "HEAD"],
            timeout=30,
        ).stdout.strip().lower()
        if observed != self._expected_commit:
            raise GateError("guest workspace HEAD does not match expected commit")

        dirty = _run(
            ["git", "-C", str(WORKSPACE), "status", "--porcelain=v1"],
            timeout=30,
        ).stdout
        if dirty:
            raise GateError("guest workspace must be clean")

    def require_clean_start(self) -> None:
        _require_clean_start(RUNTIME, CGROUP_ROOT)

    def prepare(self) -> None:
        RUNTIME.mkdir(mode=0o700, parents=False, exist_ok=False)

    def run_probe(self) -> int:
        if self._expected_commit is None:
            raise GateError("guest expected commit was not verified")
        if not _PROBE.is_file():
            raise GateError("local E2E probe is not implemented yet")

        env = {
            "HOME": "/opt/ssh-over-mcp-e2e",
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
            "PATH": "/usr/bin:/bin",
            "SSH_OVER_MCP_LIVE_EXPECTED_COMMIT": self._expected_commit,
        }
        result = subprocess.run(
            ["/usr/bin/python3", str(_PROBE)],
            cwd=WORKSPACE,
            env=env,
            capture_output=True,
            text=True,
            check=False,
            timeout=900,
        )
        if result.stdout:
            sys.stdout.write(result.stdout)
        if result.stderr:
            sys.stderr.write(result.stderr)
        return int(result.returncode)

    def cleanup(self) -> None:
        if RUNTIME.exists():
            shutil.rmtree(RUNTIME)

        if CGROUP_ROOT.exists():
            try:
                entries = list(CGROUP_ROOT.iterdir())
            except OSError as exc:
                raise GateError("cannot inspect E2E cgroup during cleanup") from exc
            if entries:
                raise GateError("E2E cgroup is not empty during cleanup")
            try:
                CGROUP_ROOT.rmdir()
            except OSError as exc:
                raise GateError("cannot remove E2E cgroup during cleanup") from exc

    def verify_clean(self) -> None:
        if RUNTIME.exists() or CGROUP_ROOT.exists():
            raise GateError("disposable E2E fixture cleanup verification failed")


def _run_gate(ops: _GuestOps) -> int:
    ops.verify_root_and_workspace()
    ops.require_clean_start()
    try:
        ops.prepare()
        return ops.run_probe()
    finally:
        ops.cleanup()
        ops.verify_clean()


def main(argv: Sequence[str] | None = None) -> int:
    arguments = tuple(sys.argv[1:] if argv is None else argv)
    if arguments:
        raise GateError("guest gate accepts no arguments")
    return _run_gate(_SystemGuestOps())


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (GateError, subprocess.SubprocessError, OSError, ValueError) as exc:
        print(f"live local E2E guest gate failed: {exc}", file=sys.stderr)
        raise SystemExit(70) from None
