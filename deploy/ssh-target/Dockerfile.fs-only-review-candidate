# ROOTLESS OPENSSH FILESYSTEM-ONLY SOURCE CANDIDATE (NOT READY).
# No sudo, root launcher, manager or cgroup access; runtime still exits 78.
# Separate signed-image/guest approval required. Never build on persistent host.
FROM --platform=linux/amd64 docker.io/library/ubuntu@sha256:42527649dbc4f9197a6073f426f488cbff0e9cc9f2afce32d91c383e4875634a

ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# Stock official Ubuntu 26.04 signed APT sources. Download + hash the exact
# .deb closure BEFORE installing. Do not disable signature verification.
RUN set -eu; \
    test -f /usr/share/keyrings/ubuntu-archive-keyring.gpg; \
    grep -q 'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' /etc/apt/sources.list.d/ubuntu.sources; \
    apt-get update; \
    mkdir -p /tmp/apt-archives/partial \
      /usr/share/ssh-over-mcp/provenance/signed-apt-lists; \
    cp -a /var/lib/apt/lists/*_InRelease \
      /usr/share/ssh-over-mcp/provenance/signed-apt-lists/; \
    cp -a /var/lib/apt/lists/*_Packages* \
      /usr/share/ssh-over-mcp/provenance/signed-apt-lists/; \
    cp /etc/apt/sources.list.d/ubuntu.sources \
      /usr/share/ssh-over-mcp/provenance/signed-apt-lists/ubuntu.sources; \
    cp /usr/share/keyrings/ubuntu-archive-keyring.gpg \
      /usr/share/ssh-over-mcp/provenance/signed-apt-lists/ubuntu-archive-keyring.gpg; \
    (cd /usr/share/ssh-over-mcp/provenance/signed-apt-lists \
      && sha256sum ./* > ../signed-apt-lists-sha256.txt); \
    apt-get -y -o Dir::Cache::archives=/tmp/apt-archives \
      --download-only install --no-install-recommends \
      openssh-server=1:10.2p1-2ubuntu3.8 \
      python3=3.14.3-0ubuntu2 \
      python3-venv=3.14.3-0ubuntu2 \
      ca-certificates=20260816ubuntu0.26.04.1; \
    test -n "$(find /tmp/apt-archives -maxdepth 1 -name '*.deb' -print -quit)"; \
    (cd /tmp/apt-archives && sha256sum ./*.deb) \
      > /usr/share/ssh-over-mcp/provenance/apt-deb-sha256.txt; \
    apt-get -y -o Dir::Cache::archives=/tmp/apt-archives \
      install --no-install-recommends \
      openssh-server=1:10.2p1-2ubuntu3.8 \
      python3=3.14.3-0ubuntu2 \
      python3-venv=3.14.3-0ubuntu2 \
      ca-certificates=20260816ubuntu0.26.04.1; \
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' \
      > /usr/share/ssh-over-mcp/provenance/apt-installed.tsv; \
    find /etc/ssh -maxdepth 1 -type f -name 'ssh_host_*' -delete; \
    test -z "$(find /etc/ssh -maxdepth 1 -name 'ssh_host_*' -print -quit)"; \
    rm -rf /tmp/apt-archives /var/lib/apt/lists/*

# Existing project-generated wheel hashes bound to a committed lock; no
# wheels are copied from an unrelated host. Record raw wheel hashes and install
# only the downloaded matching bytes. Python ABI compatibility is a build gate.
COPY requirements/runtime.lock /tmp/runtime.lock
# pip and ensurepip can explicitly generate .pyc despite
# PYTHONDONTWRITEBYTECODE; the FS-only launcher rejects cached code.
RUN set -eu; \
    python3 -m venv /opt/ssh-over-mcp-e2e/venv; \
    /opt/ssh-over-mcp-e2e/venv/bin/pip download \
      --require-hashes --only-binary=:all: --dest /tmp/wheels \
      -r /tmp/runtime.lock; \
    (cd /tmp/wheels && sha256sum ./*.whl) \
      > /usr/share/ssh-over-mcp/provenance/python-wheel-sha256.txt; \
    /opt/ssh-over-mcp-e2e/venv/bin/pip install \
      --no-index --find-links=/tmp/wheels --require-hashes \
      -r /tmp/runtime.lock; \
    find /opt/ssh-over-mcp-e2e/venv/lib/python3.14/site-packages \
      -type d -name __pycache__ -prune -exec rm -rf {} +; \
    find /opt/ssh-over-mcp-e2e/venv/lib/python3.14/site-packages \
      -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete; \
    test -z "$(find /opt/ssh-over-mcp-e2e/venv/lib/python3.14/site-packages \
      \( -name __pycache__ -o -name '*.pyc' -o -name '*.pyo' \) -print -quit)"; \
    rm -rf /tmp/wheels /tmp/runtime.lock

# Immutable source + nonroot OpenSSH ForceCommand candidate. Never embed
# real private hostkeys or authorized keys.
COPY src /opt/ssh-over-mcp-e2e/workspace/src
RUN set -eu; \
    test -z "$(find /opt/ssh-over-mcp-e2e/workspace/src \
      \( -name __pycache__ -o -name '*.pyc' -o -name '*.pyo' \) -print -quit)"
COPY ops/mvp/ssh-over-mcp-fs-only-launcher.py /usr/local/libexec/ssh-over-mcp-fs-only-launcher.py
COPY deploy/ssh-target/sshd_config.fs-only-review-candidate /etc/ssh/sshd_config
COPY deploy/ssh-target/host-policy.review-candidate.yaml /etc/ssh-over-mcp/host-policy.yaml
COPY deploy/ssh-target/entrypoint.review-hold /usr/local/libexec/ssh-over-mcp-image-hold

# UsePAM=no pubkey account must not have shadow's disabled-login marker '!'.
# '*' is an impossible password hash; password and interactive auth disabled.
RUN set -eu; \
    groupadd -g 3201 som-ssh-login; \
    useradd -u 2201 -g 3201 --no-create-home -d /nonexistent -s /bin/sh ssh-over-mcp-e2e-host; \
    usermod -p '*' ssh-over-mcp-e2e-host; \
    mkdir -p /etc/ssh/hostkeys /etc/ssh/authorized_keys /run/sshd /srv/data; \
    chown 2201:3201 /srv/data; \
    chmod 0700 /srv/data; \
    chmod 0444 /etc/ssh-over-mcp/host-policy.yaml; \
    chmod 0555 /opt/ssh-over-mcp-e2e/workspace/src /usr/local/libexec; \
    chmod 0555 /usr/local/libexec/ssh-over-mcp-fs-only-launcher.py; \
    chmod 0555 /usr/local/libexec/ssh-over-mcp-image-hold; \
    test -z "$(find /etc/ssh -maxdepth 1 -name 'ssh_host_*' -print -quit)"

EXPOSE 2222
USER 2201:3201
# Keep sshd startup disabled: signed image/key provenance, real rootless
# SSH auth, hostkey confinement, CapBnd=0/NNP=1 and two-node E2E are unproved.
ENTRYPOINT ["/usr/local/libexec/ssh-over-mcp-image-hold"]
