# OpenSSH-only *source-build* candidate. No service is authorized to start.
# Build atop the already pinned official-Ubuntu, exact-lock FS source layer.
# Never use a mutable registry tag as an approved image or Docker runtime input.
ARG SOM_FS_SOURCE_IMAGE
FROM ${SOM_FS_SOURCE_IMAGE}

USER 0:0
ENV DEBIAN_FRONTEND=noninteractive
# Trusted Ubuntu archive signatures remain mandatory: no unsigned packages.
RUN set -eu; \
    test -f /usr/share/keyrings/ubuntu-archive-keyring.gpg; \
    grep -q 'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      /etc/apt/sources.list.d/ubuntu.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends sudo util-linux; \
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' \
      sudo util-linux > /usr/share/ssh-over-mcp/provenance/openssh-fs-privsep-packages.tsv; \
    rm -rf /var/lib/apt/lists/*

COPY deploy/ssh-target/sshd_config.fs-privsep-review-candidate /etc/ssh/sshd_config
COPY deploy/ssh-target/sudoers.fs-privsep-review-candidate /etc/sudoers.d/ssh-over-mcp-fs
RUN set -eu; \
    chown root:root /etc/ssh/sshd_config /etc/sudoers.d/ssh-over-mcp-fs; \
    chmod 0644 /etc/ssh/sshd_config; \
    chmod 0440 /etc/sudoers.d/ssh-over-mcp-fs; \
    visudo -c -f /etc/sudoers.d/ssh-over-mcp-fs; \
    test -z "$(find /etc/ssh -maxdepth 1 -name 'ssh_host_*' -print -quit)"

EXPOSE 2222
# Image is NOT runnable pending bounded OCI caps/NNP private-userns and
# per-node host-key isolation / bidirectional network / MCP Level-2 tests.
ENTRYPOINT ["/usr/local/libexec/ssh-over-mcp-image-hold"]
