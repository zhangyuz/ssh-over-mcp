# DO_NOT_DEPLOY: syntactic *operator placeholders*, NOT authorized images,
# SSH key provenance, network control or runtime installation approvals.
# Copy outside the repository; NEVER place real credentials in this example.
# Supply your reviewed immutable control and per-node SSH image digests.
SSH_OVER_MCP_IMAGE=registry.example.invalid/control@sha256:DO_NOT_DEPLOY_VERIFY_CONTROL_DIGEST
SSH_OVER_MCP_NODE01_IMAGE=registry.example.invalid/ssh-node01@sha256:DO_NOT_DEPLOY_VERIFY_NODE01_DIGEST
SSH_OVER_MCP_NODE02_IMAGE=registry.example.invalid/ssh-node02@sha256:DO_NOT_DEPLOY_VERIFY_NODE02_DIGEST
SSH_OVER_MCP_PROFILE=rw-operator
SSH_OVER_MCP_CONFIG_FILE=/operator-owned/private/config.yaml
SSH_OVER_MCP_CREDENTIAL_MAP_FILE=/operator-owned/private/credentials.yaml
SSH_OVER_MCP_SSH_SECRETS_DIR=/operator-owned/private/ssh-secrets
SSH_OVER_MCP_ORIGIN_BEARER_FILE=/operator-owned/private/origin-bearer
SSH_OVER_MCP_PRIVATE_HOSTNAME=mcp.internal.example

# Additional render-only OpenSSH FS review settings (never create these paths automatically).
SSH_OVER_MCP_NODE01_HOSTKEYS_DIR=/operator-owned/private/node01-hostkeys
SSH_OVER_MCP_NODE01_AUTHORIZED_KEYS_DIR=/operator-owned/private/node01-authorized-keys
SSH_OVER_MCP_NODE02_HOSTKEYS_DIR=/operator-owned/private/node02-hostkeys
SSH_OVER_MCP_NODE02_AUTHORIZED_KEYS_DIR=/operator-owned/private/node02-authorized-keys
