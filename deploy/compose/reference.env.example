# Copy this file outside the repository before adding environment-specific paths.
SSH_OVER_MCP_IMAGE=ssh-over-mcp:phase6b
SSH_OVER_MCP_PROFILE=developer
SSH_OVER_MCP_CONFIG_FILE=/absolute/path/to/config.yaml
SSH_OVER_MCP_CREDENTIAL_MAP_FILE=/absolute/path/to/credentials.yaml
SSH_OVER_MCP_SSH_SECRETS_DIR=/absolute/path/to/ssh-secrets
SSH_OVER_MCP_ORIGIN_BEARER_FILE=/absolute/path/to/origin-bearer
