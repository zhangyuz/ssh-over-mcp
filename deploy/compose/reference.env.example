# Copy this file outside the repository before adding environment-specific paths.
SSH_OVER_MCP_IMAGE=ssh-over-mcp:phase6b
SSH_OVER_MCP_PROFILE=developer
SSH_OVER_MCP_CONFIG_FILE=/absolute/path/to/config.yaml
SSH_OVER_MCP_CREDENTIAL_MAP_FILE=/absolute/path/to/credentials.yaml
SSH_OVER_MCP_SSH_SECRETS_DIR=/absolute/path/to/ssh-secrets
SSH_OVER_MCP_ORIGIN_BEARER_FILE=/absolute/path/to/origin-bearer

# Private hostname: lowercase DNS name only, 1-253 chars; labels 1-63 chars
# using a-z, 0-9, and hyphen; no leading/trailing hyphen, IP literal, scheme,
# port, or path.
SSH_OVER_MCP_PRIVATE_HOSTNAME=mcp.internal.example
# Absolute path to the remotely managed Cloudflare Tunnel token file.
# Keep the token bytes out of this env file and out of the repository.
SSH_OVER_MCP_CLOUDFLARED_TOKEN_FILE=/absolute/path/to/cloudflare-tunnel-token
